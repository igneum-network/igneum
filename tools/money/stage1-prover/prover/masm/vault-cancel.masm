# money-vault-cancel-v1 (kind 5): the cancellation key consumes a pending note into an inbound note of the
# same vault; no destination, no amount choice, no policy field. Public: DOMAIN [chain_id, 5, 0, 0], ANCHOR,
# NF_PENDING (under nk_c), PTAG, CM_INBOUND.
# Advice, in the order read: the five public words; the policy's eight words; SK_C; the pending note (W, VID,
# PKD, HT, R, pos); the inbound note's R.
# The circuit: pk_c = H(SK_C, TAG 16), not all-zero; the pending note carries this policy's hash and is in the
# tree; nf under nk_c = H(SK_C, TAG 19); ptag = fold(TAG 15; cm, [pos], r); inbound = (w, vid, policy, r').
begin
    padw adv_loadw mem_storew_le.0
    padw adv_loadw mem_storew_le.4 swapw hmerge
    padw adv_loadw mem_storew_le.8 swapw hmerge
    padw adv_loadw mem_storew_le.12 swapw hmerge
    padw adv_loadw mem_storew_le.16 swapw hmerge
    dupw.1 assert_eqw
    mem_load.1 push.5 assert_eq
    exec.read_policy
    push.100 exec.hash_policy
    padw adv_loadw mem_storew_le.268 dropw
    push.0.0.0.16 padw mem_loadw_le.268 hmerge
    padw mem_loadw_le.104 assert_eqw
    padw mem_loadw_le.104 exec.word_is_zero not assert
    push.228 push.132 exec.copy_word
    exec.open_pending
    mem_load.248 padw mem_loadw_le.244 push.0.0.0.19 padw mem_loadw_le.268 hmerge exec.nullify
    padw mem_loadw_le.8 assert_eqw
    exec.ptag padw mem_loadw_le.12 assert_eqw
    push.400 push.220 exec.copy_word
    push.404 push.224 exec.copy_word
    push.408 push.132 exec.copy_word
    padw adv_loadw mem_storew_le.412 dropw
    push.400 exec.hash_inbound
    padw mem_loadw_le.416 padw mem_loadw_le.16 assert_eqw
end
