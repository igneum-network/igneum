# money-vault-complete-v1 (kind 6): the destination key consumes a matured pending note into two ordinary
# notes, proving the note's policy is not in the revoked set as it stood at the parent block. Public: DOMAIN
# [chain_id, 6, 0, 0], ANCHOR, REVOKED_ROOT, NF_PENDING (under nk_dest), PTAG, CM1, CM2, HT = [h_now, t_now, 0, 0].
# Advice, in the order read: the eight public words; SK_DEST; NK_DEST; the pending note's policy hash; the
# pending note (W, VID, PKD, HT, R, pos); output 0 and output 1 (V, PK, R); the revoked tree's low leaf
# [k_low, k_next, 0, 0] and its index (the path in the Merkle store under REVOKED_ROOT at depth 16).
# The circuit: pk_dest = H(SK_DEST, NK_DEST); the note is in the tree; nf and ptag; h_now >= h_req + D_b and
# t_now >= t_req + D_s (both bind, the later decides); the outputs sum to w; k_low < k < k_next (or k_next = 0)
# with k the policy hash's first element.
begin
    padw adv_loadw mem_storew_le.0
    padw adv_loadw mem_storew_le.4 swapw hmerge
    padw adv_loadw mem_storew_le.8 swapw hmerge
    padw adv_loadw mem_storew_le.12 swapw hmerge
    padw adv_loadw mem_storew_le.16 swapw hmerge
    padw adv_loadw mem_storew_le.20 swapw hmerge
    padw adv_loadw mem_storew_le.24 swapw hmerge
    padw adv_loadw mem_storew_le.28 swapw hmerge
    dupw.1 assert_eqw
    mem_load.1 push.6 assert_eq
    padw mem_loadw_le.28 u32assertw dropw
    padw adv_loadw mem_storew_le.276 dropw
    padw adv_loadw mem_storew_le.280 dropw
    padw adv_loadw mem_storew_le.228 dropw
    exec.open_pending
    padw mem_loadw_le.280 padw mem_loadw_le.276 hmerge
    padw mem_loadw_le.232 assert_eqw
    mem_load.248 padw mem_loadw_le.244 padw mem_loadw_le.280 exec.nullify
    padw mem_loadw_le.12 assert_eqw
    exec.ptag padw mem_loadw_le.16 assert_eqw
    mem_load.28 mem_load.236 mem_load.238 add gte assert
    mem_load.29 mem_load.237 mem_load.239 add gte assert
    push.600 exec.output
    push.640 exec.output
    padw mem_loadw_le.612 padw mem_loadw_le.20 assert_eqw
    padw mem_loadw_le.652 padw mem_loadw_le.24 assert_eqw
    push.424 push.600 push.640 exec.v_add
    padw mem_loadw_le.424 padw mem_loadw_le.220 assert_eqw
    padw adv_loadw mem_storew_le.440 dropw
    adv_push mem_store.444
    padw mem_loadw_le.8 mem_load.444 padw mem_loadw_le.440 exec.member_revoked
    mem_load.440 mem_load.228 lt assert
    mem_load.441 dup.0 eq.0 swap mem_load.228 swap lt or assert
end
