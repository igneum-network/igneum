# money-vault-rec-cancel-v1 (kind 9): a pending recovery is cleared; the policy stays. The cancellation
# reveals the policy hash the announcement revealed, so the node removes it from the revoked set and the
# policy's pending withdrawals complete again (F-799). Who may cancel (F-800): the recovery authority alone
# when the announced policy changes the cancellation key's commitment AND the announcement was co-signed by
# the everyday key (the owner's rotation of a compromised cancellation key: the key it replaces cannot cancel
# it); the cancellation key in every other case (a change that keeps it, or a rotation nobody co-signed: a
# compromised authority's, which the owner cancels). The everyday key never.
# Public: DOMAIN [chain_id, 9, 0, 0], ANCHOR, NF_HEAD, CM_HEAD_OUT, OLD_POLICY_HASH.
# Advice, in the order read: the five public words; the policy's eight words; SK (sk_a in the authority's
# case, else sk_c); NK_V; head_in (V, VID, IDX, SPENT, RECH, R, pos); the announced policy's eight words;
# head_out's R.
# The circuit: the policy hashes to the revealed word and is the head's; a recovery is pending and the
# announced policy hashes to it; the head's co-signature bit (IDX element 3) is 0 or 1; when the announced
# pk_c differs from the policy's and the bit is 1, pk_a = H(SK, TAG 17), not all-zero, else pk_c = H(SK,
# TAG 16), not all-zero; head_out = head_in with the recovery fields and the bit zero.
begin
    padw adv_loadw mem_storew_le.0
    padw adv_loadw mem_storew_le.4 swapw hmerge
    padw adv_loadw mem_storew_le.8 swapw hmerge
    padw adv_loadw mem_storew_le.12 swapw hmerge
    padw adv_loadw mem_storew_le.16 swapw hmerge
    dupw.1 assert_eqw
    mem_load.1 push.9 assert_eq
    exec.read_policy
    push.100 exec.hash_policy
    padw mem_loadw_le.132 padw mem_loadw_le.16 assert_eqw
    padw adv_loadw mem_storew_le.268 dropw
    padw adv_loadw mem_storew_le.176 dropw
    exec.check_nk_field
    exec.open_head
    padw mem_loadw_le.160 exec.word_is_zero not assert
    exec.read_new_policy
    push.300 exec.hash_policy
    padw mem_loadw_le.332 padw mem_loadw_le.160 assert_eqw
    mem_load.155 dup.0 dup.0 mul assert_eq
    padw mem_loadw_le.304 padw mem_loadw_le.104 eqw movdn.8 dropw dropw
    not mem_load.155 and
    if.true
        push.0.0.0.17 padw mem_loadw_le.268 hmerge
        padw mem_loadw_le.108 assert_eqw
        padw mem_loadw_le.108 exec.word_is_zero not assert
    else
        push.0.0.0.16 padw mem_loadw_le.268 hmerge
        padw mem_loadw_le.104 assert_eqw
        padw mem_loadw_le.104 exec.word_is_zero not assert
    end
    push.180 push.140 exec.copy_word
    push.184 push.144 exec.copy_word
    push.188 push.132 exec.copy_word
    push.192 exec.zero_word
    mem_load.152 mem_store.192
    push.196 push.156 exec.copy_word
    push.200 exec.zero_word
    padw adv_loadw mem_storew_le.204 dropw
    push.180 exec.hash_head
    padw mem_loadw_le.208 padw mem_loadw_le.12 assert_eqw
end
