+// IGNEUM MONEY stage one, the 128-bit cut (tools/money/stage1-prover/patches): the cubic extension F_p[X]/(X^3 - X - 1), p3-goldilocks's instance,
+// delegated exactly as the quadratic and quintic ones above are, so the STARK's challenge field
+// can be the 192-bit one (miden-air config.rs, CubeFelt). The VM's own ext2 operations keep QuadFelt.
+impl ExtensionAlgebra<Self, 3, CubicTrinomial> for Felt {
+    #[inline]
+    fn ext_mul(a: &[Self; 3], b: &[Self; 3], res: &mut [Self; 3]) {
+        trinomial_cubic_mul::<Self>(a, b, res);
+    }
+
+    #[inline]
+    fn ext_square(a: &[Self; 3], res: &mut [Self; 3]) {
+        cubic_square::<Self>(a, res);
+    }
+}
+
+impl CubicTrinomialExtendable for Felt {
+    const FROBENIUS_MATRIX: [[Self; 3]; 3] = {
+        let m = <Goldilocks as CubicTrinomialExtendable>::FROBENIUS_MATRIX;
+        [
+            [Self(m[0][0]), Self(m[0][1]), Self(m[0][2])],
+            [Self(m[1][0]), Self(m[1][1]), Self(m[1][2])],
+            [Self(m[2][0]), Self(m[2][1]), Self(m[2][2])],
+        ]
+    };
+
+    const EXT_GENERATOR: [Self; 3] = {
+        let g = <Goldilocks as CubicTrinomialExtendable>::EXT_GENERATOR;
+        [Self(g[0]), Self(g[1]), Self(g[2])]
+    };
+}
+
+impl HasTwoAdicCubicExtension for Felt {
+    const EXT_TWO_ADICITY: usize = <Goldilocks as HasTwoAdicCubicExtension>::EXT_TWO_ADICITY;
+
+    #[inline]
+    fn ext_two_adic_generator(bits: usize) -> [Self; 3] {
+        let g = <Goldilocks as HasTwoAdicCubicExtension>::ext_two_adic_generator(bits);
+        [Self(g[0]), Self(g[1]), Self(g[2])]
+    }
+}
